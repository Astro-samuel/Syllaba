{
  "name": "syllaba-free-syllabus-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop AI Syllabus & Academic Schedule Tracker",
  "author": "Syllaba Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:start": "node scripts/launch-electron.cjs",
    "electron:dev": "cross-env NODE_ENV=development node scripts/launch-electron.cjs",
    "electron:build": "npm run build && electron-builder --win --dir",
    "electron:make": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.syllaba.desktop",
    "productName": "Syllaba Academic Tracker",
    "directories": {
      "output": "build-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@netlify/functions": "^5.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "fs-extra": "^11.4.0",
    "jsdom": "^29.1.1",
    "netlify-cli": "^27.1.1",
    "postcss": "^8.5.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
